# Modelfile for Ollama — BraneScript fine-tuned model
#
# Usage:
#   1. After running: python fine_tuning/train.py --export
#   2. Edit the FROM path below to point to your GGUF file
#   3. Run: ollama create branescript-qwen -f fine_tuning/Modelfile.template
#   4. In pipeline.py, set model="branescript-qwen" in the Ollama(...) call

FROM ./fine_tuning/gguf/branescript-qwen-q4_k_m.gguf

SYSTEM """You are an expert in the Brane Framework and BraneScript.
Given a user intent, generate ONLY valid BraneScript code.
Do NOT output Python, Java, or any other language.
Do NOT wrap the output in markdown code fences.
Use `let <name> := <expr>;` for variable assignment.
Call package functions as `<package>::<function>(args)`.
Output raw BraneScript code only."""

PARAMETER temperature 0.4
PARAMETER top_p 0.9
PARAMETER top_k 20
PARAMETER repeat_penalty 1.0
