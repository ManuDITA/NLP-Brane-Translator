# .env.example — Brane Remote Execution Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
#
# Usage on local machine:
#   source .env
#   python scripts/remote_execution/local/brane_executor.py &
#   bash scripts/remote_execution/local/start_tunnel.sh

# ── Shared secret ─────────────────────────────────────────────────────────
# Must be set to the same value on both local machine and Snellius.
# Generate with:  openssl rand -hex 32
BRANE_EXECUTOR_TOKEN=REPLACE_WITH_YOUR_TOKEN

# ── Snellius connection ───────────────────────────────────────────────────
SNELLIUS_USER=esimeone
SNELLIUS_HOST=snellius.surf.nl

# ── Tunnel settings ───────────────────────────────────────────────────────
# Port used for the reverse SSH tunnel and the executor HTTP server.
# Must be the same on both sides. Choose a port > 1024 not in use.
TUNNEL_PORT=9753

# Path to the dedicated SSH key for the tunnel (generated by setup_local.sh).
TUNNEL_SSH_KEY=/home/esimeone/.ssh/brane_tunnel_key

# ── Local Brane settings ──────────────────────────────────────────────────
# The Brane instance name as shown by `brane instance list`.
BRANE_INSTANCE=local-instance

# Maximum seconds to wait for a single workflow execution (default: 300).
BRANE_EXECUTOR_TIMEOUT=300
