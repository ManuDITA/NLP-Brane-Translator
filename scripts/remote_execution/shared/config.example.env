# .env.example — Brane Remote Execution Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
#
# Usage on local machine:
#   eval $(ssh-agent -s) && ssh-add ~/.ssh/snelliuskey.pem
#   source .env
#   python scripts/remote_execution/local/job_watcher.py

# ── Snellius connection ───────────────────────────────────────────────────
export SNELLIUS_USER=esimeone
export SNELLIUS_HOST=snellius.surf.nl

# ── Job queue (file-based, no port forwarding needed) ────────────────────
# Directory on the Snellius filesystem where jobs are queued.
# Single quotes prevent local tilde expansion — remote shell expands it correctly.
export SNELLIUS_JOBS_DIR='~/brane_jobs'

# ── HuggingFace token (for model downloads) ───────────────────────────────
export HF_TOKEN=REPLACE_WITH_YOUR_TOKEN

# ── Local Brane settings ──────────────────────────────────────────────────
# Maximum seconds to wait for a single workflow execution (default: 300).
export BRANE_EXECUTOR_TIMEOUT=300
